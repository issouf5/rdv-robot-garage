-- 2. POLITIQUES POUR LA TABLE GARAGES
DROP POLICY IF EXISTS "Lecture des garages par membres" ON public.garages;
CREATE POLICY "Lecture des garages par membres" ON public.garages
  FOR SELECT USING (
    id = public.current_garage_id(id)
  );

DROP POLICY IF EXISTS "Modification du garage par admin" ON public.garages;
CREATE POLICY "Modification du garage par admin" ON public.garages
  FOR UPDATE USING (
    id = public.current_garage_id(id) AND EXISTS (
      SELECT 1 FROM public.garage_users 
      WHERE user_id = auth.uid() AND garage_id = id AND role IN ('super_admin', 'admin_garage')
    )
  );

-- 3. POLITIQUES POUR GARAGE_USERS
DROP POLICY IF EXISTS "Voir membres de son garage" ON public.garage_users;
CREATE POLICY "Voir membres de son garage" ON public.garage_users
  FOR SELECT USING (
    garage_id = public.current_garage_id(garage_id)
  );

