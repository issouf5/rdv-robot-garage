ALTER TABLE public.garages ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.garage_users ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.customers ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.vehicles ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.appointments ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.work_orders ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.parts ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.work_order_parts ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.invoices ENABLE ROW LEVEL SECURITY;

-- POLITIQUES GARAGES
CREATE POLICY p_garages_select ON public.garages FOR SELECT
  USING (id = public.current_garage_id(id));

-- POLITIQUES CUSTOMERS
CREATE POLICY p_customers_all ON public.customers FOR ALL
  USING (garage_id = public.current_garage_id(garage_id));

-- POLITIQUES VEHICLES
CREATE POLICY p_vehicles_all ON public.vehicles FOR ALL
  USING (garage_id = public.current_garage_id(garage_id));

-- POLITIQUES APPOINTMENTS
CREATE POLICY p_appointments_all ON public.appointments FOR ALL
  USING (garage_id = public.current_garage_id(garage_id));

-- POLITIQUES WORK ORDERS
CREATE POLICY p_work_orders_all ON public.work_orders FOR ALL
  USING (garage_id = public.current_garage_id(garage_id));

-- POLITIQUES PARTS
CREATE POLICY p_parts_all ON public.parts FOR ALL
  USING (garage_id = public.current_garage_id(garage_id));

-- POLITIQUES INVOICES
CREATE POLICY p_invoices_all ON public.invoices FOR ALL
  USING (garage_id = public.current_garage_id(garage_id));
